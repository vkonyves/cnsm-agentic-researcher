# ============================================================
# Keep reproducibility artefacts tracked
#
# These exceptions matter if broader parent directories are
# ignored now or later.
# ============================================================

!configs/
!configs/**
!scripts/
!scripts/**
!src/
!src/**
!tests/
!tests/**

!README.md
!LICENSE
!pyproject.toml
!requirements.txt
!requirements-dev.txt
!environment.yml
!environment.yaml
!uv.lock
!poetry.lock

# Track small manifests, hashes, preregistrations and summaries
!manifests/
!manifests/**
!preregistrations/
!preregistrations/**
!reports/
!reports/**

# These are useful if copied out of runs/ into tracked folders
!**/*manifest.json
!**/*manifest.yaml
!**/*manifest.yml
!**/*preregistration.json
!**/*summary.json
!**/*report.json
!**/*sha256*
