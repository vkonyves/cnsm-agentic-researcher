profiling/


# ============================================================
# Reproducibility artefacts
#
# These directories are intentionally tracked. No recursive
# source-directory negations are used here because rules such
# as !scripts/**, !src/**, and !tests/** would also re-include
# generated __pycache__ directories.
# ============================================================

!configs/
!scripts/
!src/
!tests/

!README.md
!LICENSE
!pyproject.toml
!requirements.txt
!requirements-dev.txt
!environment.yml
!environment.yaml
!uv.lock
!poetry.lock

# Track reproducibility outputs when they are stored in these
# dedicated, non-ignored directories.
!manifests/
!manifests/**
!preregistrations/
!preregistrations/**
!reports/
!reports/**


# ============================================================
# Final generated-file exclusions
#
# Keep this block last so future re-inclusion rules cannot
# accidentally expose generated Python caches.
# ============================================================

**/__pycache__/
**/*.py[cod]
.pytest_cache/